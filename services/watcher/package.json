  "dependencies": {
    "@defi-sentinel/domain": "workspace:*",
    "@defi-sentinel/rules": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
